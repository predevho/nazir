# Supabase 공개(anon) 설정 — supabase.com 프로젝트의 Project Settings > API 에서 복사
# 실제 값은 .env.local 에 넣으세요(.env.local 은 git에 커밋되지 않습니다).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 공개 사이트 주소 — OG 공유 카드와 sitemap.xml 의 절대 URL 기준값입니다.
# 비워두면 Vercel 도메인을 쓰고, 로컬에서는 http://localhost:3000 을 씁니다.
# 확정 도메인은 nazir.cloud 입니다. Vercel 프로젝트 환경변수에도 같은 값을 넣으세요.
# 틀리면 카톡 공유 썸네일과 sitemap.xml 이 엉뚱한 주소를 가리킵니다.
NEXT_PUBLIC_SITE_URL=https://nazir.cloud
